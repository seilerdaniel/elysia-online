# Copia este archivo a server/.env y ajusta los valores.
# .env está en .gitignore: NUNCA lo subas al repositorio.

# Puerto HTTP del servidor
PORT=5000

# Conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambia_esta_password
DB_NAME=elysia_db

# Clave para firmar los JWT. Obligatoria: el servidor no arranca sin ella.
# Genera una propia con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=genera_una_clave_larga_y_aleatoria
